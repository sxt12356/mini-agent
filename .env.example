OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=604800

DATABASE_URL=postgresql+psycopg://mini_user:mini_password@localhost:5432/mini_agent

JWT_SECRET_KEY=change-this-to-a-long-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

AGENT_LOG_DIR=logs

CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_PER_DAY=500
LOGIN_IP_RATE_LIMIT_PER_MINUTE=20
LOGIN_USER_IP_RATE_LIMIT_PER_MINUTE=5
